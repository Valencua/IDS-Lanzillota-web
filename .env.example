# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# Clave secreta usada por Flask para firmar las sesiones.
# Generá una aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-aleatoria

# Credenciales para acceder al panel de administración (/admin/login).
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame
