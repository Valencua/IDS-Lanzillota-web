# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# Clave secreta usada por Flask para firmar las sesiones.
# Generá una aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-aleatoria

# URL base de la API del backend (ids-api). Opcional (default: http://localhost:5000/ids_api).
# El login del panel de administración se valida contra esta API; las
# credenciales de admin viven en el .env de ids-api, no acá.
API_BASE_URL=http://localhost:5000/ids_api
